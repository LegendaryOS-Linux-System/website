[package]
-> name        => legendaryos-website
-> version     => 0.2.0
-> description => Strona LegendaryOS napisana w HackerScript (use <mode:website>).
-> license     => Apache-2.0
-> lang        => hs

[layout]
-> cmd => src

[commands]
-> site
--> run => bash scripts/build-site.sh dist
--> description => Zbuduj strone (HackerScript -> index.html + app.js) do dist/
